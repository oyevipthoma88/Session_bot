#!/usr/bin/env bash
set -e
echo "=== Cleanup old forks ==="
pip uninstall -y pyrogram pyrofork pyrotgfork pyromod pyrogrammod 2>/dev/null || true
echo "=== Install PyroTGFork (Layer 224+) ==="
pip install pyrotgfork
echo "=== Verify colored buttons ==="
python -c "from pyrogram.types import KeyboardButtonStyle; print('COLOR: OK')" || echo "COLOR: MISSING"
python -c "from pyrogram import Client; print('LISTEN:', 'OK' if hasattr(Client, 'listen') else 'MISSING')"
echo "=== POST_COMPILE DONE ==="
